# 身份域（对齐后端 ft.iam.clients：admin / merchant / app / gateway）
VITE_APP_CLIENT_CODE=admin

# 默认租户编码，登录表单预填（后端 iam_tenant.code）
VITE_APP_TENANT_CODE=fighter
